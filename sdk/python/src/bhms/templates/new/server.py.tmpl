"""{{title}}: a simulated stage. `bhms dev server.py` explores it; `pytest` tests it."""
from bhms import DeviceServer, Range


def build(memory: bool = False) -> DeviceServer:
    srv = DeviceServer("{{name}}", **({"store": None} if memory else {}))
    dev = srv.device("{{device_id}}", name="{{title}}", capabilities=["bhms.axis.linear"], resources=["{{device_id}}"])
    dev.report_alive()
    stage = {"um": 0.0}  # the simulated device: replace with your driver

    @dev.property(unit="um", evidence="simulated")
    def position() -> float:
        return stage["um"]

    @dev.action(effect="reversible", idempotency="absolute", max_duration_ms=5000)
    async def move_to(ctx, target: Range(0, 200, unit="um")) -> {"position": "um"}:  # noqa: F821
        stage["um"] = target
        return {"position": target}

    return srv


srv = build()

if __name__ == "__main__":
    srv.run()
