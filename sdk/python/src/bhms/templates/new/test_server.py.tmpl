"""Tests for {{title}}. Run with `pytest` (no hardware, no sockets: the server runs in-process)."""

import asyncio
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from bhms.testing import connect  # noqa: E402
from server import build  # noqa: E402


def run(coroutine):
    return asyncio.run(coroutine)


def test_the_device_is_described_honestly():
    async def scenario():
        async with connect(build(memory=True)) as client:
            description = (await client.devices_describe("{{device_id}}")).description
            assert description.actions["move_to"].effect == "reversible"
            assert description.properties["position"].evidence == "simulated"
    run(scenario())


def test_move_to_reaches_the_target_and_says_so():
    async def scenario():
        async with connect(build(memory=True)) as client:
            op = (await client.actions_invoke("{{device_id}}", "move_to", {"target": 42.5}, operation_key="t-1",
                                              wait_ms=2000)).operation
            assert op.state == "completed" and op.result == {"position": 42.5}
            reading = (await client.properties_read("{{device_id}}", "position")).observation
            assert reading.value == 42.5 and reading.evidence == "simulated"
    run(scenario())


def test_a_target_outside_the_travel_is_refused_and_nothing_moves():
    async def scenario():
        async with connect(build(memory=True)) as client:
            try:
                await client.actions_invoke("{{device_id}}", "move_to", {"target": 500})
            except Exception as error:  # BhmsError: OUT_OF_RANGE, mayHaveActed false, with a hint
                assert error.code == "OUT_OF_RANGE" and error.may_have_acted is False and error.hint
            else:
                raise AssertionError("expected a refusal")
            assert (await client.properties_read("{{device_id}}", "position")).observation.value == 0.0
    run(scenario())


def test_retrying_with_the_same_key_does_not_move_twice():
    async def scenario():
        async with connect(build(memory=True)) as client:
            first = await client.actions_invoke("{{device_id}}", "move_to", {"target": 10}, operation_key="k", wait_ms=2000)
            again = await client.actions_invoke("{{device_id}}", "move_to", {"target": 10}, operation_key="k", wait_ms=2000)
            assert again.replayed and again.operation.operation_id == first.operation.operation_id
    run(scenario())
