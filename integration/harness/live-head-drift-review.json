  "findings": [
    {
      "id": "direct-api-source-unchanged",
      "classification": "static_compatibility_evidence",
      "sources": [
        "packages/core",
        "vendor",
        "packages/ptc-runtime",
        "packages/preset/agent-session",
        "packages/boot",
        "packages/config",
        "packages/subprocess",
        "packages/sandbox",
        "packages/session",
        "packages/llm",
        "packages/fs",
        "packages/util"
      ],
      "finding": "The complete Git trees of direct HMS overlay/test dependencies are identical between the tested base and inspected head. Loader/Include, Tool schema/registry/execution/finalization, AgentLoop, Session, Node PTC, Agent session leasing service, subprocess and sandbox implementations have no source delta in those trees. No direct HMS API incompatibility was identified by this bounded static review.",
      "limit": "Tree identity is not an execution result on the new aggregate composition or dependency environment."
    },
    {
      "id": "sdk-profile-work-items",
      "classification": "behavioral_composition_change",
      "sources": [
        "packages/bundle/sdk-app/cordis.patch.yml",
        "packages/bundle/sdk-app/package.json",
        "packages/transport/transport-sdk/src/index.ts"
      ],
      "finding": "SDK profile now mounts work-store and work-executors with claims=home, executor-session, channels-builtin and transport-sdk. agent/invoke and trigger/admit enter durable work-item processing; work/settled and work/attention report later lifecycle state. The old HMS focused test uses its own Loader composition and does not mount this SDK work-item surface.",
      "hms_implication": "Any new SDK-profile HMS claim needs actual profile composition, shutdown, recovery and cancellation tests. The home claim concerns Harness work items, not HMS daemon ownership or physical resource fencing."
    },
    {
      "id": "sdk-session-target",
      "classification": "additive_api_and_behavior_change",
      "sources": [
        "packages/sdk/server/src/methods.ts",
        "packages/sdk/server/src/server.ts"
      ],
      "finding": "SdkCall.lease now accepts optional target for composing a new session. A target supplied for a session already open in the SDK runtime is refused; creation passes the selected target into agentSessions.compose. durablePromptContent is exported and clones the no-image content array.",
      "hms_implication": "Direct core agent-session API is unchanged. A new SDK entry path must ensure the intended agent/profile includes the hardware layer; existing Session attribution must not become HMS authorization."
    },
    {
      "id": "request-replay-vs-hms-intent",
      "classification": "lifecycle_change_and_binding_boundary",
      "sources": [
        "packages/work/work-executors/src/call-source.ts",
        "packages/transport/transport-cli/src/index.ts",
        "packages/transport/transport-sdk/src/index.ts",
        "packages/sdk/client/src/api.ts"
      ],
      "finding": "CLI/SDK share CallSource: source-scoped native key combines home and requestId; fingerprint mismatch is refused; an ended item returns stored result, while an open item can be taken over. A session occupied by queued/running/settling work is awaited; other open waiting work refuses the new request as busy. SDK invoke selects the existing work item before composing a new session on an exact repeated request.",
      "hms_implication": "Harness request IDs and work-item takeover are a separate layer from immutable HMS intent keys and receipts. work/retry or a fresh agent turn must not be treated as evidence that an accepted HMS operation did not run. Reconcile retained HMS requests and operations after ambiguous outcomes."
    },
    {
      "id": "cancellation-and-authority",
      "classification": "integration_risk_not_a_confirmed_regression",
      "sources": [
        "packages/transport/transport-sdk/src/index.ts",
        "packages/work/work-executors/src/call-source.ts",
        "packages/work/work-store/src/service.ts",
        "integration/harness/packages/tool-hardware/src/index.ts",
        "integration/harness/packages/hardware-hms/src/index.ts"
      ],
      "finding": "New SDK work/cancel, work/retry and work/resume operate on Harness work items; watcher lifetime is tied to the SDK call/runtime signal, and shutdown ends watches with later work/get reconciliation. The local SDK operator principal derives from the process account. No new bridge from these work-item methods to the HMS hardware_cancel operation exists in the retained overlay.",
      "hms_implication": "Canceling a Harness item/turn or client subprocess must retain uncertainty for an already accepted HMS operation; use explicit HMS cancellation and operation reads for that layer. Work-item or Session IDs do not add per-agent authority to the same-UID HMS service."
    },
    {
      "id": "build-and-overlay-overlap",
      "classification": "revalidation_required",
      "sources": [
        "pnpm-lock.yaml",
        "tsconfig.base.json",
        "tsconfig.host.json",
        "packages/sdk/protocol/package.json",
        "packages/work/work-executors/package.json",
        "python/sdk-runtime/package.json"
      ],
      "finding": "Exactly three files touched by the retained overlay also changed upstream: pnpm-lock.yaml, tsconfig.base.json and tsconfig.host.json. Upstream adds transport-sdk mapping/project reference and 112 lockfile importer lines, plus SDK/protocol/work/Python runtime dependency declarations. Root package.json, pnpm-workspace.yaml and scripts/run-gates.ts have no diff.",
      "hms_implication": "Reconcile the overlay against the new exact head and rerun dependency, compiled-export, focused type/lint/native/PTC/Session and build artifact/check evidence before claiming support. Neither clean patch applicability nor passing builds/tests at the new head was tested here."
    }
  ],
