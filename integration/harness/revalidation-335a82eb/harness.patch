+      yield { type: 'tool-call-delta', index: 0, id, name, argumentsDelta: argumentText };
+      yield { type: 'block-end', index: 0, block: { type: 'tool-call', id, name, arguments: argumentText } };
+      yield { type: 'finish', reason: { kind: 'tool-calls' } };
+    }
