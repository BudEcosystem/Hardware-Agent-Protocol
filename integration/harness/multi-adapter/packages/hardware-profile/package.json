{
  "name": "@budmh/experimental-hardware-profile",
  "description": "Experimental same-UID local HMS simulation hardware-profile",
  "version": "0.2.1-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BudEcosystem/Bud-Meta-Harness.git",
    "directory": "packages/experimental/hardware-profile"
  },
  "dependencies": {
    "@budmh/experimental-hardware-hms": "workspace:*",
    "@budmh/experimental-tool-hardware": "workspace:*"
  },
  "peerDependencies": {
    "@budmh/cordis": "workspace:~"
  },
  "devDependencies": {
    "@budmh/cordis": "workspace:~"
  },
  "budmh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
