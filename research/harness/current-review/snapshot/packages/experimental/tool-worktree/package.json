{
  "name": "@budmh/experimental-tool-worktree",
  "description": "Model tool that creates and enters a new Git worktree",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BudEcosystem/Bud-Meta-Harness.git",
    "directory": "packages/experimental/tool-worktree"
  },
  "peerDependencies": {
    "@budmh/cordis": "workspace:~",
    "@budmh/tools": "workspace:*",
    "@budmh/experimental-worktree": "workspace:*"
  },
  "devDependencies": {
    "@budmh/cordis": "workspace:~",
    "@budmh/cordis-plugin-include": "workspace:~",
    "@budmh/cordis-plugin-loader": "workspace:~",
    "@budmh/agent": "workspace:*",
    "@budmh/agent-loop-testkit": "workspace:*",
    "@budmh/fs-local": "workspace:*",
    "@budmh/llm": "workspace:*",
    "@budmh/sandbox": "workspace:*",
    "@budmh/sandbox-local": "workspace:*",
    "@budmh/sandbox-policy": "workspace:*",
    "@budmh/session": "workspace:*",
    "@budmh/session-projection": "workspace:*",
    "@budmh/subprocess-local": "workspace:*",
    "@budmh/system-prompt": "workspace:*",
    "@budmh/tools": "workspace:*",
    "@budmh/working-directory": "workspace:*",
    "@budmh/experimental-worktree": "workspace:*",
    "@budmh/agent-loop": "workspace:*"
  },
  "icon": "./icon.svg",
  "budmh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@budmh/experimental-worktree": "workspace:*"
  }
}
