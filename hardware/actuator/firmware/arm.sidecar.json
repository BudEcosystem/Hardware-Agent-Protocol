  "actions": {
    "move_joints": {
      "description": "Move all five joints to absolute angles along a straight line in joint space, at speed_pct of the per-joint speed limit (servo no-load speed / ratio). The device refuses a goal outside any joint range or coupled limit (shoulder+elbow <= 175, elbow+wrist_pitch <= 165, shoulder+elbow+wrist_pitch <= 183 deg) with OUT_OF_RANGE: detail 0..4 = joint range of base_yaw, shoulder_pitch, elbow_pitch, wrist_pitch, wrist_roll; 16 = coupled forearm_pitch (shoulder+elbow <= 175 deg), 17 = hairpin (elbow+wrist_pitch <= 165 deg), 18 = tool_pitch (shoulder+elbow+wrist_pitch <= 183 deg); 240 = speed. Every interpolated waypoint is checked again on the device. Result: worst joint error at the end, measured.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "base_yaw",
          "shoulder_pitch",
          "elbow_pitch",
          "wrist_pitch",
          "wrist_roll",
          "speed_pct"
        ],
        "properties": {
          "base_yaw": {
            "type": "number",
            "x-bhms-unit": "deg",
            "minimum": -150.0,
            "maximum": 150.0,
            "multipleOf": 0.01
          },
          "shoulder_pitch": {
            "type": "number",
            "x-bhms-unit": "deg",
            "minimum": -20.0,
            "maximum": 95.0,
            "multipleOf": 0.01
          },
          "elbow_pitch": {
            "type": "number",
            "x-bhms-unit": "deg",
            "minimum": -5.0,
            "maximum": 125.0,
            "multipleOf": 0.01
          },
          "wrist_pitch": {
            "type": "number",
            "x-bhms-unit": "deg",
            "minimum": -100.0,
            "maximum": 100.0,
            "multipleOf": 0.01
          },
          "wrist_roll": {
            "type": "number",
            "x-bhms-unit": "deg",
            "minimum": -150.0,
            "maximum": 150.0,
            "multipleOf": 0.01
          },
          "speed_pct": {
            "type": "integer",
            "x-bhms-unit": "%",
            "minimum": 5,
            "maximum": 100
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "max_error_deg"
        ],
        "properties": {
          "max_error_deg": {
            "type": "number",
            "x-bhms-unit": "deg",
            "minimum": 0,
            "maximum": 655.35,
            "multipleOf": 0.01
          }
        }
      },
      "effect": "reversible",
      "idempotency": "absolute",
      "cancel": "supported",
      "completionEvidence": "measured",
      "maxDurationMs": 60000,
      "requiresLease": true,
      "resources": [
        "bhms-arm/joints"
      ],
      "onLeaseLoss": "hold",
      "compact": {
        "index": 0,
        "args": [
          {
            "name": "base_yaw",
            "type": "i16",
            "scale": 0.01
          },
          {
            "name": "shoulder_pitch",
            "type": "i16",
            "scale": 0.01
          },
          {
            "name": "elbow_pitch",
            "type": "i16",
            "scale": 0.01
          },
          {
            "name": "wrist_pitch",
            "type": "i16",
            "scale": 0.01
          },
          {
            "name": "wrist_roll",
            "type": "i16",
            "scale": 0.01
          },
          {
