        "type": "object",
        "additionalProperties": false,
        "required": [
          "speed_pct"
        ],
        "properties": {
          "speed_pct": {
            "type": "integer",
            "x-bhms-unit": "%",
            "minimum": 5,
            "maximum": 100
          }
        }
      },
      "output": {
        "type": "object",
