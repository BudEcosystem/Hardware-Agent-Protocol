{
  "deviceId": "bhms-arm",
  "name": "BHMS Arm",
  "description": "A 5-axis desktop arm (STS3215 servos) with a quick-change tool flange (gripper, knob turner, button presser, slider pusher), driven by an RP2040 controller over BHMS-Compact. Joint ranges, three coupled pitch limits, the shoulder torque cap and the E-stop restart inhibit are enforced on the device. After an E-stop the arm may have moved: re-home before use. Faults: 1 estop, 2 estop_fault_contact_A_or_Q2, 3 servo_rail_fault, 4 overcurrent, 5 servo_comm, 6 servo_error, 7 tool_lost, 8 timeout, 9 overtemp, 10 stopped, 11 bus_collision, 12 limit, 13 selftest, 14 no_actuator_power, 15 power_sense, 16 servo_config, 17 tool.",
  "capabilities": [
    "bhms.arm.joints",
    "bhms.arm.tool"
  ],
  "tags": [
    "bhms-arm"
  ],
  "resources": [
    "bhms-arm/joints",
    "bhms-arm/power",
    "bhms-arm/tool"
  ],
