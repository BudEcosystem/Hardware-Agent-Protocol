{
  "$id": "urn:bud:hms:schema:resource-binding-proof:0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Staged synthetic shape contract. Python additionally enforces exact integer types, byte bounds, references and closure semantics.",
  "properties": {
    "actionRoots": {
      "additionalProperties": {
        "items": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "maxItems": 256,
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "maxProperties": 128,
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
        "type": "string"
      },
      "type": "object"
    },
    "bindingGeneration": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
      "type": "string"
    },
    "closureDigest": {
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "dependencies": {
      "additionalProperties": {
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
        "type": "string"
      },
      "maxProperties": 128,
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
        "type": "string"
      },
      "type": "object"
    },
    "expandedClaims": {
      "additionalProperties": {
        "items": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "maxItems": 32,
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "maxProperties": 128,
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
        "type": "string"
      },
      "type": "object"
    },
    "instanceId": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?![\\s\\S])",
      "type": "string"
    },
    "profile": {
      "const": "hms.resource-binding-proof/0.1"
    },
    "topologyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "instanceId",
    "bindingGeneration",
    "topologyDigest",
    "actionRoots",
    "expandedClaims",
    "dependencies",
    "closureDigest"
  ],
  "type": "object"
}
