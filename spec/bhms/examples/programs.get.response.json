            "steps"
          ],
          "properties": {
            "start": {
              "type": "number",
              "x-bhms-unit": "um",
              "minimum": 0,
              "maximum": 5000
            },
            "steps": {
              "type": "integer",
              "x-bhms-unit": "1",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "effect": "reversible",
        "worstCaseDurationMs": 137000,
        "maxDurationMs": 140000,
        "stepCount": 7,
        "maxExecutedSteps": 202,
        "devices": [
          "focus-1"
        ],
        "resources": [
          "focus-1/axis"
        ],
        "requiresLease": true
      }
    }
  }
