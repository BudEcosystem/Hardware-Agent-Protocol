{
  "$comment": "The immutable program and its info.",
  "against": "#/$defs/ProgramsGetResponse",
  "message": {
    "jsonrpc": "2.0",
    "id": 17,
    "result": {
      "resultType": "complete",
      "program": {
        "bhmsProgram": "2026-11-13",
        "name": "focus_scan",
        "description": "Step the focus axis and record the position at each step.",
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "steps"
          ],
          "properties": {
            "start": {
              "type": "number",
              "x-bhms-unit": "um",
              "minimum": 0,
              "maximum": 5000
            },
            "steps": {
              "type": "integer",
              "x-bhms-unit": "1",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "maxDurationMs": 140000,
        "steps": [
          {
            "kind": "invoke",
            "id": "home",
            "deviceId": "focus-1",
            "action": "move_to",
            "arguments": {
              "position": "${start}"
            }
          },
          {
            "kind": "waitUntil",
            "deviceId": "focus-1",
            "property": "position",
            "predicate": {
              "op": "within",
              "left": "${observed.value}",
              "right": "${start}",
              "tolerance": 1
            },
            "timeoutMs": 2000,
            "pollMs": 50
          },
          {
            "kind": "repeat",
            "times": "${steps}",
            "as": "i",
            "steps": [
              {
                "kind": "invoke",
                "deviceId": "focus-1",
                "action": "move_by",
                "arguments": {
                  "distance": 10
                },
                "saveAs": "moved"
              },
              {
                "kind": "sleep",
                "durationMs": 100
              },
              {
                "kind": "read",
                "deviceId": "focus-1",
                "property": "position",
                "fresh": true,
                "timeoutMs": 500,
                "saveAs": "pos"
              },
              {
                "kind": "assert",
                "predicate": {
                  "all": [
                    {
                      "op": "eq",
                      "left": "${pos.quality}",
                      "right": "valid"
                    },
                    {
                      "not": {
                        "op": "gt",
                        "left": "${pos.value}",
                        "right": 9000
                      }
                    }
                  ]
                },
                "message": "focus position invalid or beyond 9000 um"
              }
            ]
          }
        ],
        "output": {
          "lastPosition": "${pos.value}"
        }
      },
      "info": {
        "digest": "sha256:d664364d3cd14a395cafacdb45248dfe1e911e0704fe27c06e7a1f40a35d1dc2",
