 "accepted": [
  {
   "name": "quantity in the declared unit is accepted and unwrapped",
   "device": "axis-1",
   "action": "move_to",
   "arguments": {
    "position": {
     "value": 5,
     "unit": "mm"
    }
   },
   "expect": {
    "admitted": {
     "position": 5
    }
   }
  },
  {
   "name": "lower bound is accepted",
   "device": "axis-1",
   "action": "move_to",
   "arguments": {
    "position": 0
   },
   "expect": {
    "admitted": null
   }
  },
  {
   "name": "upper bound is accepted",
   "device": "axis-1",
   "action": "move_to",
   "arguments": {
    "position": 200
   },
   "expect": {
