{
 "description": "Argument vectors for the conformance device (axis-1 / pump-1). `refused`: the server must answer a JSON-RPC error with expect.code (one code or a list), naming expect.field, with a bound member `expect.bound` when given, mayHaveActed false, and must create no operation and move the device-side counter by zero. `accepted`: the request is admitted and completes; expect.admitted (when not null) is the admittedArguments member.",
 "refused": [
  {
   "name": "move_to above maximum",
   "device": "axis-1",
   "action": "move_to",
   "arguments": {
    "position": 200.1
   },
   "expect": {
    "code": "OUT_OF_RANGE",
    "field": "arguments.position",
    "bound": "maximum"
   }
  },
  {
   "name": "move_to one ulp above maximum",
   "device": "axis-1",
   "action": "move_to",
   "arguments": {
    "position": 200.00000000000003
   },
   "expect": {
    "code": "OUT_OF_RANGE",
    "field": "arguments.position",
    "bound": "maximum"
   }
  },
  {
   "name": "move_to below minimum",
   "device": "axis-1",
   "action": "move_to",
   "arguments": {
    "position": -0.1
   },
   "expect": {
    "code": "OUT_OF_RANGE",
    "field": "arguments.position",
    "bound": "minimum"
   }
  },
  {
