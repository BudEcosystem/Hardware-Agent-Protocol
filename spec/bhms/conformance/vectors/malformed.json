{
 "description": "Raw messages the runner sends byte for byte. {{meta}} is replaced by the request _meta object, {{version}} by the protocol version; encoding latin-1 turns each character into one byte (so a character above U+007F becomes an invalid UTF-8 sequence). expect.rpcCodes lists the acceptable JSON-RPC error codes; when -32602 is listed the error data must carry expect.bhmsCode. A response is required: the server must refuse, never accept.",
 "vectors": [
  {
   "name": "nan-token",
   "group": "nan",
   "ids": [
    "BHMS-LIF-001"
   ],
   "raw": "{\"jsonrpc\":\"2.0\",\"id\":9001,\"method\":\"devices/list\",\"params\":{\"_meta\":{{meta}},\"limit\":NaN}}",
   "expect": {
    "rpcCodes": [
     -32700,
     -32602
    ],
    "bhmsCode": "INVALID_ARGUMENT"
   },
   "why": "NaN is not an RFC 8259 number"
  },
