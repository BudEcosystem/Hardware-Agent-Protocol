<mujoco model="simlab bench">
  <!-- The bench. The arm model is attached at site arm_mount by simlab.world.World (arm model = a parameter).
       Units: metres. The arm base faces -Y. Objects (plate, slide) are kinematic mocap bodies: the ledger owns where
       they are; the world moves them to the site, the gripper or the floor (see World._place). -->
  <compiler angle="radian"/>
  <option timestep="0.002" cone="elliptic" impratio="10"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
  </visual>
  <asset>
    <material name="steel" rgba="0.62 0.64 0.68 1"/>
    <material name="bench" rgba="0.78 0.74 0.66 1"/>
    <material name="instrument" rgba="0.25 0.28 0.32 1"/>
    <material name="plastic" rgba="0.85 0.88 0.95 0.9"/>
    <material name="glass" rgba="0.8 0.9 1 0.6"/>
    <material name="knob" rgba="0.1 0.1 0.1 1"/>
    <material name="floor" rgba="0.3 0.3 0.33 1"/>
  </asset>
  <default>
    <geom contype="0" conaffinity="0"/>
    <joint damping="0.002"/>
  </default>
  <worldbody>
    <light pos="0 -0.2 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" pos="0 0 -0.7" size="3 3 0.05" material="floor"/>
    <geom name="bench_top" type="box" pos="0 -0.2 -0.02" size="0.55 0.45 0.02" material="bench"/>
    <site name="arm_mount" pos="0 0 0"/>

    <!-- Named sites: where objects rest (tool reference point height 0.02 m). -->
    <site name="hotel" pos="-0.24 -0.12 0.02" size="0.01"/>
    <site name="slide_rack" pos="-0.12 -0.12 0.02" size="0.01"/>
    <site name="lh_deck" pos="-0.18 -0.28 0.02" size="0.01"/>
    <site name="microscope_stage" pos="0.04 -0.26 0.02" size="0.01"/>
    <site name="reader" pos="0.22 -0.18 0.02" size="0.01"/>
    <site name="balance" pos="0.25 -0.05 0.02" size="0.01"/>

    <geom name="hotel_pad" type="box" pos="-0.24 -0.12 -0.002" size="0.07 0.05 0.002" material="steel"/>
    <geom name="rack_pad" type="box" pos="-0.12 -0.12 -0.002" size="0.03 0.03 0.002" material="steel"/>
    <geom name="lh_pad" type="box" pos="-0.18 -0.28 0.0" size="0.07 0.05 0.004" material="instrument"/>
    <geom name="reader_body" type="box" pos="0.22 -0.18 0.0" size="0.07 0.05 0.01" material="instrument"/>
    <geom name="balance_pan" type="cylinder" pos="0.25 -0.05 0.005" size="0.045 0.005" material="steel"/>

    <!-- Microscope body: stage at microscope_stage; four knobs on its right side. Each knob is a hinge joint. -->
    <body name="microscope" pos="0.04 -0.34 0">
      <geom name="scope_base" type="box" pos="0 0 0.012" size="0.09 0.05 0.012" material="instrument"/>
      <geom name="scope_arm" type="box" pos="0 -0.035 0.12" size="0.025 0.012 0.1" material="instrument"/>
      <geom name="scope_head" type="box" pos="0 -0.01 0.23" size="0.03 0.04 0.02" material="instrument"/>
      <geom name="scope_stage_plate" type="box" pos="0 0.08 0.005" size="0.05 0.035 0.005" material="steel"/>
      <camera name="scope" pos="0.0 0.08 0.22" xyaxes="1 0 0 0 1 0" fovy="8"/>
      <body name="knob_focus_coarse" pos="0.095 -0.03 0.06">
        <joint name="focus_coarse" type="hinge" axis="1 0 0"/>
        <geom type="cylinder" fromto="0 0 0 0.02 0 0" size="0.016" material="knob"/>
      </body>
      <body name="knob_focus_fine" pos="0.095 -0.03 0.1">
        <joint name="focus_fine" type="hinge" axis="1 0 0"/>
        <geom type="cylinder" fromto="0 0 0 0.02 0 0" size="0.009" material="knob"/>
      </body>
      <body name="knob_stage_x" pos="0.095 0.02 0.02">
        <joint name="stage_x_knob" type="hinge" axis="1 0 0"/>
        <geom type="cylinder" fromto="0 0 0 0.02 0 0" size="0.012" material="knob"/>
      </body>
      <body name="knob_stage_y" pos="0.095 0.05 0.02">
        <joint name="stage_y_knob" type="hinge" axis="1 0 0"/>
        <geom type="cylinder" fromto="0 0 0 0.02 0 0" size="0.012" material="knob"/>
      </body>
    </body>

    <!-- Movable labware: mocap bodies (the ledger decides where they are). -->
    <body name="plate" mocap="true" pos="-0.24 -0.12 0.02">
      <geom type="box" size="0.0638 0.0427 0.007" material="plastic"/>
    </body>
    <body name="slide" mocap="true" pos="-0.12 -0.12 0.02">
      <geom type="box" size="0.0375 0.0125 0.0005" material="glass"/>
    </body>

    <camera name="overhead" pos="0.0 -0.2 0.95" xyaxes="1 0 0 0 1 0" fovy="55"/>
  </worldbody>
</mujoco>
