+# Only successful JSON Schema checks are reused. The exact bounded bytes and
+# validator object identify an entry; callers still get a fresh parsed tree and
+# every topology/generation/authority-dependent semantic check runs normally.
+# Eight carrier-sized keys retain at most 512 KiB of document bytes. Validators
+# are private import-time objects; this cache is not a deployment attestation.
+_SCHEMA_MEMO_LIMIT = 8
+_SCHEMA_MEMO = OrderedDict()
+_SCHEMA_MEMO_LOCK = threading.Lock()
+
 
 class ResourceTopologyError(JournalError):
     """Stable refusal without interpreting a document as authority."""
