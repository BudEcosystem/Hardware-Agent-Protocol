+class PresenceAgeExpired(JournalError):
+    """Trusted policy: matching presence expired after static authorization.
+
+    The public refusal stays DEVICE_UNAVAILABLE. A runtime may acquire one new
+    observation before fresh admission; this marker never permits dispatch or
+    refresh of a retained operation, missing presence or changed identity.
+    """
+    def __init__(self, adapter_id: str):
+        self.adapter_id = adapter_id
+        super().__init__("DEVICE_UNAVAILABLE")
 
 
