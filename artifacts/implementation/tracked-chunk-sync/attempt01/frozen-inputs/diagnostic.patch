+def install_sync_counters():
+    import hierarchical_store as implementation
+    original_loader=implementation._block_module
+    class Proxy:
+        def __init__(self,original):self.original=original
+        def __getattr__(self,name):return getattr(self.original,name)
+        def fsync(self,fd):
+            SYNC_COUNTS['fsync']+=1
+            return self.original.fsync(fd)
+    def loader(path,wanted):
+        module=original_loader(path,wanted)
+        module.os=Proxy(module.os)
+        if hasattr(module,'_wait_file'):
+            original_wait=module._wait_file
+            def wait(fd):
+                SYNC_COUNTS['wait']+=1
+                return original_wait(fd)
+            module._wait_file=wait
+        return module
+    implementation._block_module=loader
+
