+def copy_closed_state(state, location):
+    """Retain exact closed bytes; original private state remains untouched."""
+    info = state.lstat()
+    require(stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and
+            stat.S_IMODE(info.st_mode) == 0o700 and
+            (info.st_dev, info.st_ino) == (location['device'], location['inode']), 'STATE_DIRECTORY_CHANGED')
+    names = ('authority.db', 'authority.db.owner', 'simulated-plant.db', 'simulated-plant.db.owner')
+    require(sorted(p.name for p in state.iterdir()) == sorted(names), 'CLOSED_STATE_FILES')
+    destination = ATTEMPT / 'state-snapshot'
+    destination.mkdir(mode=0o700, exist_ok=False)
+    joined = []
+    for name in names:
+        source = state / name
+        info = source.lstat()
+        require(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and
+                stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == 1, 'CLOSED_STATE_FILE_TYPE')
+        raw = data(source)
+        retained = save('state-snapshot/' + name, raw, raw=True)
+        require(data(source) == raw == data(destination / name), 'CLOSED_STATE_COPY_CHANGED')
+        joined.append({'originalPath': str(source), 'originalDevice': info.st_dev,
+                       'originalInode': info.st_ino, **retained})
+    require(snapshot(destination) == snapshot(state), 'COPIED_STATE_QUERY_MISMATCH')
+    return joined
