+def child_exited_unreaped(process):
+    # Do not call Popen.poll/wait: the owned leader anchors numeric group identity.
+    return os.waitid(os.P_PID,process.pid,os.WEXITED|os.WNOHANG|os.WNOWAIT) is not None
