+            self.record()
+        self.arm(check)
+        self.code('COMMIT_CHECK_IMPURE', self.submit)
+        self.empty()
+        self.assertEqual(self.calls, ['checked'])
+        self.assertIsNone(self.journal._pat_evidence_guard)
+
