+    def test_check_baseexception_rolls_back_and_releases_scope(self):
+        def interrupt():
+            self.record()
+            raise KeyboardInterrupt('test only')
+        self.arm(interrupt)
+        with self.assertRaises(KeyboardInterrupt):
