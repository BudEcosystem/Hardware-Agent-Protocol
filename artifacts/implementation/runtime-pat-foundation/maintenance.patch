+def historical_toolchain(archive, files):
+    """Verify retained compiler bytes without requiring an old temporary install.
+
+    Existing installed paths must still match. Missing paths are recorded as
+    archive-only checks; no compiler is extracted, installed or executed.
+    """
+    global checks
+    archive_path = ROOT / archive['path']
+    verify(archive_path, archive['sha256'])
+    key = (str(archive_path), archive['sha256'])
+    cached = toolchain_members.setdefault(key, {})
+    needed = {item['archive_member'] for item in files.values()} - cached.keys()
+    if needed:
+        found, links = {}, {}
+        with tarfile.open(archive_path, 'r|bz2') as source:
+            for member in source:
+                if member.name not in needed:
+                    continue
+                if member.name in found or member.name in links:
+                    raise ValueError('Duplicate pinned toolchain member: ' + member.name)
+                if member.islnk():
+                    target = Path(member.linkname)
+                    if target.is_absolute() or '..' in target.parts:
+                        raise ValueError('Unsupported toolchain hard-link target')
+                    links[member.name] = member.linkname
+                    continue
+                if not member.isfile() or not 0 <= member.size <= 64 * 1024 * 1024:
+                    raise ValueError('Unexpected pinned toolchain member: ' + member.name)
+                hasher, size = hashlib.sha256(), 0
+                with source.extractfile(member) as stream:
+                    while data := stream.read(1024 * 1024):
+                        hasher.update(data); size += len(data)
+                if size != member.size:
+                    raise ValueError('Incomplete toolchain member: ' + member.name)
+                found[member.name] = hasher.hexdigest()
+        if found.keys() | links.keys() != needed:
+            raise ValueError('Pinned toolchain archive is missing selected members')
+        # Hard links are archive-root references. Resolve only to another
+        # explicitly selected, hashed member; never to a filesystem path.
+        for name in links:
+            target, seen = name, set()
+            while target in links:
+                if target in seen or len(seen) >= 16:
+                    raise ValueError('Cyclic or excessive toolchain hard links')
+                seen.add(target); target = links[target]
+            expected = found.get(target, cached.get(target))
+            if expected is None:
+                raise ValueError('Toolchain hard link has no selected hashed target')
+            found[name] = expected
+        verify(archive_path, archive['sha256'])
+        cached.update(found)
+    for path, item in files.items():
+        if cached[item['archive_member']] != item['sha256']:
+            raise ValueError('Historical toolchain archive member differs: ' + item['archive_member'])
+        checks += 1
+        installed = Path(path)
+        present = installed.exists() or installed.is_symlink()
+        if present:
+            verify(installed, item['sha256'])
+        historical_toolchain_checks.append(dict(historicalPath=path,
+            archive=archive['path'], archiveMember=item['archive_member'],
+            sha256=item['sha256'], installedPathPresent=present,
+            verification='archive_and_installed_path' if present else 'archive_only'))
 
 
