+def check_audit(entries):
+    require(type(entries) is list and len(entries)<=64,'Audit bound')
+    previous=0
+    for entry in entries:
+        require(type(entry) is dict and set(entry)=={'opcode','tx','body','bodySha256'})
+        require(type(entry['opcode']) is int and type(entry['tx']) is int and previous<entry['tx']<2**32)
+        body=bytes.fromhex(entry['body'])
+        require(2<=len(body)<=192 and body[0]==2 and body[1]==entry['opcode'] and sha(body)==entry['bodySha256'])
+        previous=entry['tx']
