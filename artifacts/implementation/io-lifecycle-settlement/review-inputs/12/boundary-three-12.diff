+            graph['nodes']['hub']['contains'].append('svcIdle')
+            graph['nodes']['svcIdle'] = node('service',{'serviceProfile':'synthetic-service/0.1'},requires=('hub',))
+            graph['atoms']['atom:svcIdle'] = {'node':'svcIdle','purpose':'lifecycle'}
+            self.configuration['io']['initialGenerations'] = generations(graph)
+            self.configuration['management'][0]['actions']['advance_idle'] = 'svcIdle'
+            self.runtime = LifecycleRuntime(self.directory,create=True,owner=self.owner,installation=self.configuration,
+                wall_clock_ms=lambda:self.wall,monotonic_ms=lambda:self.mono)
+            self.namespace = self.runtime.journal.issue_namespace(self.owner,100000)['token']
+            ordinary = self.submit(instance='sim:gpio5',action='gpio_pulse',key='retained-ordinary')
+            self.runtime.tick(); self.advance(20); self.runtime.tick()
+            self.assertEqual(self.current(ordinary)['state'],'completed')
+            old_receipt = self.runtime.io_board.validated_receipt(ordinary['id'])
+            self.assertIsNotNone(old_receipt)
+            def ordinary_history():
+                authority, board = self.runtime.journal._db, self.runtime.io_board.db
+                return {
+                    'bindings':[tuple(row) for row in authority.execute('SELECT * FROM reg_bindings ORDER BY instance')],
+                    'bindingHistory':[tuple(row) for row in authority.execute('SELECT * FROM reg_binding_history ORDER BY instance,generation')],
+                    'authorityReceipts':[tuple(row) for row in authority.execute('SELECT * FROM io_authority_receipts ORDER BY operation,sequence')],
+                    'modelReceipts':[tuple(row) for row in board.execute('SELECT * FROM io_receipts ORDER BY operation')],
+                    'modelVersions':[tuple(row) for row in board.execute('SELECT * FROM io_receipt_versions ORDER BY operation,sequence')],
+                    'ordinaryEffects':[tuple(row) for row in board.execute('SELECT * FROM io_effects ORDER BY instance')]}
+            historical = ordinary_history()
+            self.assertTrue(historical['authorityReceipts']); self.assertTrue(historical['modelVersions'])
+            before = self.runtime.catalog.resources.snapshot(self.owner)
+            self.capture('ordinary-receipt-before-empty-service-advance')
+            request = self.request(action='advance_idle',key='empty-service')
+            operation = self.runtime.journal.submit(self.owner,canonical(request))
+            self.assertEqual([row['resource'] for row in operation['claims']],['atom:svcIdle'])
+            _ticket, receipt = self.effect_only(operation)
+            self.assertIs(receipt['generationApplied'],True)
+            self.assertEqual(receipt['dispatch']['target'],'svcIdle')
+            self.assertEqual(receipt['dispatch']['scope']['claims'],['atom:svcIdle'])
+            self.assertEqual(receipt['dispatch']['scope']['affectedConsumers'],[])
+            self.assertEqual(receipt['dispatch']['affected'],{})
+            self.assertEqual(self.current(operation)['claims'],operation['claims'])
+            self.capture('empty-service-provider-committed-before-settlement')
+            settled = self.adapter.settle(operation['id'])
+            self.assertEqual(settled['publication']['bindings'],{})
+            self.assertEqual((settled['publication']['target'],settled['publication']['revision']),('svcIdle',2))
+            self.assertEqual(self.current(operation)['state'],'completed')
+            self.assertEqual(self.current(operation)['claims'],[])
+            after = self.runtime.catalog.resources.snapshot(self.owner)
+            self.assertEqual(after['revision'],2)
+            self.assertEqual(after['generations']['nodes'],before['generations']['nodes']|{'svcIdle':'generation:2'})
+            self.assertEqual(ordinary_history(),historical)
+            self.assertEqual(self.runtime.io_board.validated_receipt(ordinary['id']),old_receipt)
+            self.assertEqual(self.runtime.journal.submit(self.owner,canonical(request))['id'],operation['id'])
+            self.assertEqual(self.adapter.settle(operation['id']),settled)
+            self.assertEqual(self.runtime.io_board.db.execute('SELECT count(*) FROM io_lc_receipts').fetchone()[0],1)
+            self.assertEqual(self.runtime.journal._db.execute('SELECT count(*) FROM lc_publications').fetchone()[0],1)
+        except BaseException as exc:
+            self.temp.failed(exc,phase='empty-service-boundary-test'); raise
