+    def test_direct_driver_generation_owns_siblings_and_replays_one_publication(self):
+        try:
+            from hms.resource_topology import binding_proof
+            from hms.resource_catalog import control_generation
+            before = self.runtime.catalog.resources.snapshot(self.owner)
+            bindings = {instance:self.runtime.registry._binding(instance)[0]
+                        for instance in self.runtime.catalog.io.definitions}
+            management = self.runtime.registry._binding('sim:management')[0]
+            request = self.request(action='advance_driver',key='driver-target')
+            operation = self.runtime.journal.submit(self.owner,canonical(request))
+            expected_claims = ['atom:chan0','atom:driverA','atom:pin5','atom:pin6','atom:timer0']
+            self.assertEqual([row['resource'] for row in operation['claims']],expected_claims)
+            self.capture('driver-admitted-before-effect')
+            _ticket, receipt = self.effect_only(operation)
+            self.assertIs(receipt['generationApplied'],True)
+            self.assertEqual(receipt['dispatch']['target'],'driverA')
+            self.assertEqual(receipt['dispatch']['scope']['claims'],expected_claims)
+            self.assertEqual({(row['instanceId'],row['actionId']) for row in receipt['dispatch']['scope']['affectedConsumers']},
+                {('sim:gpio5','gpio_pulse'),('sim:gpio5','gpio_sibling'),
+                 ('sim:gpio5:other-route','gpio_pulse'),('sim:pwm5','pwm_burst')})
+            affected = {'sim:gpio5','sim:gpio5:other-route','sim:pwm5'}
+            self.assertEqual(set(receipt['dispatch']['affected']),affected)
+            self.assertEqual(self.current(operation)['claims'],operation['claims'])
+            self.assertEqual(self.runtime.catalog.resources.snapshot(self.owner)['revision'],1)
+            self.capture('driver-provider-committed-before-settlement')
+            settled = self.adapter.settle(operation['id']); publication = settled['publication']
+            self.assertEqual(self.current(operation)['state'],'completed')
+            self.assertEqual(self.current(operation)['claims'],[])
+            after = self.runtime.catalog.resources.snapshot(self.owner)
+            self.assertEqual(after['revision'],2)
+            self.assertEqual(after['generations']['nodes'],before['generations']['nodes']|{'driverA':'generation:2'})
+            self.assertEqual(after['generations']['nodes']['svcA'],before['generations']['nodes']['svcA'])
+            self.assertEqual(set(publication['bindings']),affected)
+            self.assertEqual((publication['target'],publication['generation'],publication['revision']),
+                             ('driverA','generation:2',2))
+            for instance, previous in bindings.items():
+                current = self.runtime.registry._binding(instance)[0]
+                if instance in affected:
+                    proof = binding_proof(after['topology'],after['generations'],instance)
+                    expected = previous|{'generation':proof['bindingGeneration'],'controlGeneration':control_generation(proof)}
+                    self.assertEqual(current,expected)
+                    self.assertNotEqual(current['generation'],previous['generation'])
+                    self.assertNotEqual(current['controlGeneration'],previous['controlGeneration'])
+                    self.assertEqual(publication['bindings'][instance],{'generation':proof['bindingGeneration'],
+                        'proofDigest':digest('HMS-LIFECYCLE-PUBLISHED-PROOF-v1',proof)})
+                    self.assertEqual(self.runtime.catalog.resources.history(self.owner,instance,current['generation']),
+                                     {'proof':proof,'binding':expected})
+                else:
+                    self.assertEqual(current,previous)
+            self.assertEqual(self.runtime.registry._binding('sim:management')[0],management)
+            replay = self.runtime.journal.submit(self.owner,canonical(request))
+            self.assertEqual(replay['id'],operation['id'])
+            self.assertEqual(self.adapter.settle(operation['id']),settled)
+            self.assertEqual(self.runtime.io_board.lifecycle_receipt(operation['id']),receipt)
+            self.assertEqual(self.runtime.catalog.resources.snapshot(self.owner)['revision'],2)
+            self.assertEqual(self.runtime.io_board.db.execute('SELECT count(*) FROM io_lc_receipts').fetchone()[0],1)
+            self.assertEqual(self.runtime.io_board.db.execute('SELECT count(*) FROM io_lc_snapshots').fetchone()[0],2)
+            self.assertEqual(self.runtime.journal._db.execute('SELECT count(*) FROM lc_publications').fetchone()[0],1)
+            self.assertEqual(self.runtime.journal._db.execute(
+                "SELECT count(*) FROM events WHERE operation_id=? AND kind='resources_released'",(operation['id'],)).fetchone()[0],1)
+        except BaseException as exc:
+            self.temp.failed(exc,phase='driver-boundary-test'); raise
