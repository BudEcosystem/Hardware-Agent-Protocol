+    def _storage_profile(self):
+        """Read current storage requirements; never reinterpret damaged state as legacy."""
+        version = self._meta("version")
+        if version not in {"hms.registry/0.1", "hms.registry/resource-roots/0.1"}:
+            raise JournalError("UNSUPPORTED_REGISTRY")
+        resource_tables = {"reg_resource_requirements", "reg_resource_instances", "rc_catalog", "rc_generations", "rc_tokens", "rc_proofs"}
+        present = {row[0] for row in self._db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+        if ((version == "hms.registry/0.1" and resource_tables & present) or
+                (version == "hms.registry/resource-roots/0.1" and not resource_tables <= present)):
+            raise JournalError("RESOURCE_STORAGE_PARTIAL")
+        return version
 
